{
  "manifest_version": 3,
  "name": "Jobio — Capture de missions",
  "version": "1.0.0",
  "description": "Capture des missions freelance en 1 clic depuis Malt, Comet, LinkedIn et autres plateformes.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://jobio.app/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.svg",
      "48": "icons/icon-48.svg",
      "128": "icons/icon-128.svg"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.malt.fr/*",
        "https://www.malt.com/*",
        "https://app.comet.co/*",
        "https://www.linkedin.com/jobs/*",
        "https://www.linkedin.com/feed/*",
        "https://www.indeed.fr/*",
        "https://www.indeed.com/*",
        "https://www.welcometothejungle.com/*",
        "https://www.crewz.fr/*",
        "https://www.free-work.com/*"
      ],
      "js": ["content-script.js"],
      "css": ["content-style.css"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.svg",
    "48": "icons/icon-48.svg",
    "128": "icons/icon-128.svg"
  },
  "background": {
    "service_worker": "background.js"
  }
}
