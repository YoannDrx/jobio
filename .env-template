# Database URL (use the same address in development, only use pooled in production if you use neon.tech)
# https://neon.tech/docs/guides/prisma
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

## * Redis (Required for caching)
# Get from: Railway ($5/mo), Redis Cloud (free tier), Upstash, or local Docker
# Railway: redis://default:password@host:port
# Redis Cloud: redis://default:password@host:port
# Local: redis://localhost:6379
REDIS_URL=""

## * Scheduled jobs (required in preview/production)
# Generate with: openssl rand -base64 32
CRON_SECRET=""

## * Legal identity (required by the production preflight)
LEGAL_BUSINESS_NAME="Yodev"
LEGAL_FORM="Entreprise individuelle"
LEGAL_SIRET=""
LEGAL_ADDRESS=""
LEGAL_VAT_NOTICE=""

## * Dated production evidence (required only for a public release)
# ISO-8601 timestamps are supplied by the named reviewer/test owner. Never
# backfill them without the corresponding report in the release dossier.
LEGAL_REVIEW_APPROVED_AT=""
PRIVACY_REVIEW_APPROVED_AT=""
ACCOUNTING_REVIEW_APPROVED_AT=""
SECURITY_REVIEW_APPROVED_AT=""
PITR_RESTORE_VERIFIED_AT=""
STRIPE_LIVE_SMOKE_VERIFIED_AT=""
MULTI_BROWSER_E2E_VERIFIED_AT=""
WEBHOOK_BACKLOG_VERIFIED_AT=""
PITR_RETENTION_HOURS=""
MOBILE_LIGHTHOUSE_SCORE=""

## * NextAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

## BetterAuth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=


## * Resend
RESEND_API_KEY=""
RESEND_AUDIENCE_ID=""
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM="Jobio <jobio@yodev.fr>"
NEXT_PUBLIC_EMAIL_CONTACT="hello@press-say.app"

## * STRIPE
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_JOBIO_PORTAL_CONFIGURATION_ID=""
STRIPE_PRO_PLAN_ID=""
STRIPE_PRO_YEARLY_PLAN_ID=""
STRIPE_PROGRAM_ATTIRER_PRICE_ID=""
STRIPE_PROGRAM_BRANDING_PRICE_ID=""
STRIPE_PROGRAM_CROISSANCE_PRICE_ID=""

NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

UPLOADTHING_TOKEN=''

## * Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact email for push notification service
VAPID_SUBJECT="mailto:hello@press-say.app"
# Same as VAPID_PUBLIC_KEY, exposed to the client for subscription
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

## * OpenAI (for Jobio AI assistants)
OPENAI_API_KEY=""

## * Radar Missions (providers optional; manual import remains available)
OPPORTUNITY_INBOUND_DOMAIN="opportunites.jobio.fr"
FRANCE_TRAVAIL_CLIENT_ID=""
FRANCE_TRAVAIL_CLIENT_SECRET=""
FRANCE_TRAVAIL_API_URL="https://api.francetravail.io/partenaire/offresdemploi/v2"
FRANCE_TRAVAIL_TOKEN_URL="https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=/partenaire"
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
ADZUNA_LICENSE_APPROVED_AT=""
JOOBLE_API_KEY=""
JOOBLE_LICENSE_APPROVED_AT=""

## * SEO Ops (optional - Admin /ops external metrics)
# Option A: Inline JSON snapshot (see docs/seo/05-search-metrics-snapshot.example.json)
SEO_SEARCH_METRICS_JSON=""
# Option B: Absolute path to JSON snapshot file on server
SEO_SEARCH_METRICS_FILE=""
# Option C (recommended): Auto-fetch snapshot from secure endpoint
SEO_SEARCH_METRICS_ENDPOINT=""
SEO_SEARCH_METRICS_BEARER_TOKEN=""
# Timeout in ms for endpoint fetch (default: 8000)
SEO_SEARCH_METRICS_TIMEOUT_MS="8000"
