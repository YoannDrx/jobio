enum PlatformCategory {
  GENERALIST
  SPECIALIZED
  ENTERPRISE
}

enum PlatformStatus {
  NOT_REGISTERED
  REGISTERED
  ACTIVE
}

model Platform {
  id          String           @id @default(nanoid(11))
  name        String
  slug        String           @unique
  website     String?
  logoUrl     String?
  category    PlatformCategory @default(GENERALIST)
  description String?
  isSystem    Boolean          @default(true)

  createdAt DateTime @default(now())

  userPlatforms UserPlatform[]
  missions      Mission[]

  @@map("platform")
}

model UserPlatform {
  id         String         @id @default(nanoid(11))
  userId     String
  platformId String
  profileUrl String?
  status     PlatformStatus @default(NOT_REGISTERED)

  createdAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([userId, platformId])
  @@map("user_platform")
}
