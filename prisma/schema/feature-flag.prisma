model FeatureFlag {
  key            String  @id
  label          String
  description    String?
  enabled        Boolean @default(false)
  scope          String  @default("global")
  updatedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@index([updatedAt])
  @@map("feature_flag")
}
