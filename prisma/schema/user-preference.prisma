model UserPreference {
  id     String @id @default(nanoid(11))
  userId String @unique

  locale String @default("fr")
  theme  String @default("system")

  notifyFollowUpDue     Boolean @default(true)
  notifyMissionStale    Boolean @default(true)
  notifyAiQuota         Boolean @default(true)
  weeklyDigest          Boolean @default(false)
  opportunityDigest     Boolean @default(true)
  notifyOverdueInvoices Boolean @default(true)

  pushFollowUpDue     Boolean @default(true)
  pushMissionStale    Boolean @default(true)
  pushAiQuota         Boolean @default(false)
  pushWeeklyDigest    Boolean @default(false)
  pushOverdueInvoices Boolean @default(false)

  proTrialStartedAt  DateTime?
  proTrialEndsAt     DateTime?
  proTrialConsumedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preference")
}

model ProTrialIdentity {
  id                 String    @id @default(nanoid(11))
  emailFingerprint   String    @unique
  firstUserId        String
  stripeCustomerId   String?   @unique
  createdAt          DateTime  @default(now())
  consumedAt         DateTime?
  retentionExpiresAt DateTime?
  updatedAt          DateTime  @updatedAt

  @@index([firstUserId])
  @@map("pro_trial_identity")
}
