model User {
  id              String   @id
  name            String
  email           String
  emailVerified   Boolean
  image           String?
  createdAt       DateTime
  updatedAt       DateTime
  resendContactId String?

  // Outgoing
  sessions     Session[]
  accounts     Account[]
  feedbacks    Feedback[]
  subscription Subscription?

  missions                           Mission[]
  followUps                          FollowUp[]
  activityEvents                     ActivityEvent[]
  contacts                           Contact[]
  profiles                           UserProfile[]
  userPlatforms                      UserPlatform[]
  messageTemplates                   MessageTemplate[]
  aiUsages                           AIUsage[]
  aiMonthlyQuotas                    AIMonthlyQuota[]
  aiQuotaAdjustmentsReceived         AIQuotaAdjustment[]                 @relation("AIQuotaAdjustmentTarget")
  aiQuotaAdjustmentsAuthored         AIQuotaAdjustment[]                 @relation("AIQuotaAdjustmentActor")
  notifications                      Notification[]
  sentEmails                         SentEmail[]
  sequences                          Sequence[]
  programPurchases                   ProgramPurchase[]
  targetCompanies                    TargetCompany[]
  aiChatThreads                      AIChatThread[]
  calendarFeedToken                  CalendarFeedToken?
  analyticsSnapshots                 AnalyticsSnapshot[]
  followUpRules                      FollowUpRule[]
  templateUsages                     MessageTemplateUsage[]
  linkedInAudits                     LinkedInAudit[]
  pushSubscriptions                  PushSubscription[]
  clientPortals                      ClientPortal[]
  preference                         UserPreference?
  aiRecommendations                  AIRecommendation[]
  dailyStrategies                    DailyStrategy[]
  cvLabDocuments                     CvLabDocument[]
  cvLabDocumentVersions              CvLabDocumentVersion[]
  cvLabCoachSessions                 CvLabCoachSession[]
  cvLabCoachMessages                 CvLabCoachMessage[]
  masterCv                           MasterCv?
  billingProfile                     BillingProfile?
  billingClients                     BillingClient[]
  billingClientContacts              BillingClientContact[]
  billingCatalogItems                BillingCatalogItem[]
  billingNumberingSequences          BillingNumberingSequence[]
  billingQuotes                      BillingQuote[]
  billingQuoteVersions               BillingQuoteVersion[]
  billingInvoices                    BillingInvoice[]
  billingInvoiceVersions             BillingInvoiceVersion[]
  billingCreditNotes                 BillingCreditNote[]
  billingPayments                    BillingPayment[]
  billingDeclarationPeriods          BillingDeclarationPeriod[]
  billingSocialContributionSnapshots BillingSocialContributionSnapshot[]
  billingAuditEvents                 BillingAuditEvent[]
  billingExpenseInvoices             BillingExpenseInvoice[]
  billingExpenseNotes                BillingExpenseNote[]
  billingExpenseTrips                BillingExpenseTrip[]
  adminNotesReceived                 AdminUserNote[]                     @relation("AdminUserNoteTarget")
  adminNotesAuthored                 AdminUserNote[]                     @relation("AdminUserNoteAuthor")

  // Stripe integration
  stripeCustomerId String?

  // Onboarding
  onboardingDismissed          Boolean @default(false)
  freelanceOnboardingDismissed Boolean @default(false)

  role       String?
  banned     Boolean?
  banReason  String?
  banExpires DateTime?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Subscription {
  id                   String    @id
  plan                 String
  referenceId          String    @unique
  user                 User      @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String?
  periodStart          DateTime?
  periodEnd            DateTime?
  cancelAtPeriodEnd    Boolean?

  @@map("subscription")
}
