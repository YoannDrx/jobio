model MessageTemplateUsage {
  id         String  @id @default(nanoid(11))
  templateId String
  userId     String
  missionId  String?
  channel    String
  source     String?

  createdAt DateTime @default(now())

  template MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission  Mission?        @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@index([userId])
  @@map("message_template_usage")
}
