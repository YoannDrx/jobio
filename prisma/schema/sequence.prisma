model Sequence {
  id          String  @id @default(nanoid(11))
  userId      String
  name        String
  description String?
  steps       Json
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sequence")
}
