model AdminUserNote {
  id           String @id @default(nanoid(11))
  userId       String
  authorUserId String
  content      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User @relation("AdminUserNoteTarget", fields: [userId], references: [id], onDelete: Cascade)
  author User @relation("AdminUserNoteAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([authorUserId, createdAt])
  @@map("admin_user_note")
}
