model DailyStrategy {
  id     String @id @default(nanoid(11))
  userId String

  date                DateTime @default(now()) @db.Date
  summary             String
  priorities          Json // string[]
  quickWins           Json // string[]
  risks               Json // string[]
  completedPriorities Json     @default("[]") // number[] (index des items cochés)
  completedQuickWins  Json     @default("[]") // number[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_strategy")
}
