enum SnapshotType {
  DAILY
  WEEKLY
  MONTHLY
}

model AnalyticsSnapshot {
  id     String       @id @default(nanoid(11))
  userId String
  type   SnapshotType
  date   DateTime
  data   Json

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, date])
  @@index([userId, type])
  @@map("analytics_snapshot")
}
