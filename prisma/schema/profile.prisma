model UserProfile {
  id                 String    @id @default(nanoid(11))
  userId             String
  name               String
  headline           String
  bio                String?
  skills             Json?
  experiences        Json?
  education          Json?
  certifications     Json?
  languages          Json?
  projects           Json?
  tjmTarget          Int?
  workTypePreference WorkType?
  zone               String?
  minDuration        String?
  maxDuration        String?
  isDefault          Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  missions       Mission[]
  linkedInAudits LinkedInAudit[]
  clientPortals  ClientPortal[]

  @@map("user_profile")
}
